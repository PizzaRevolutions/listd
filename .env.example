# Database Settings
POSTGRES_USER=listd
POSTGRES_PASSWORD=listd_secret
POSTGRES_DB=listd_db
DATABASE_URL=postgresql://listd:listd_secret@localhost:5432/listd_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Backend Settings
PORT=3000
JWT_SECRET=super_secret_jwt_key_replace_in_production
CORS_ORIGIN=*

# External Media API Keys (Obtain for free from each platform)
# TMDB (The Movie Database): https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# RAWG (Video Games): https://rawg.io/apidocs
RAWG_API_KEY=
# Spotify (Music): https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cloudflare Tunnel Token (Optional, for Proxmox public access)
CLOUDFLARE_TUNNEL_TOKEN=
